<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".tip">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/tip_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tg1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. 수평을 맞추자"
                        android:textAlignment="center"
                        android:textSize="16dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="30dp"
                        android:text="수평을 맞추지 않는다면 어색하게 느껴집니다.
                                \n하지만 수평을 맞추게 된다면 훨씬 안정적으로 느껴지고, \n사진의 퀄리티가 올라갑니다." />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginHorizontal="70dp"
                        android:layout_marginVertical="10dp"
                        android:background="#000000" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tg2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2. 그리드를 활용하자"
                        android:textAlignment="center"
                        android:textSize="16dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="수평을 맞추기 어렵다면 설정화면의 그리드를 사용하여
                        \n카메라에 격자를 추가하고 편하고 쉽게 맞추세요."
                        android:layout_marginBottom="30dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginHorizontal="70dp"
                        android:layout_marginVertical="10dp"
                        android:background="#000000" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tg3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3. 렌즈를 잘 확인하자"
                        android:textAlignment="center"
                        android:textSize="16dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="30dp"
                        android:text="아무리 잘찍더라도 렌즈가 더럽다면 사진이 흐리게 나옵니다. \n렌즈를 잘 확인합시다." />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginHorizontal="70dp"
                        android:layout_marginVertical="10dp"
                        android:background="#000000" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tg4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="4. 초점 및 노출을 조절하자"
                        android:textAlignment="center"
                        android:textSize="16dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="30dp"
                        android:text="스마트폰 카메라는 자동적으로 초점과 노출을 조절해 주지만 \n필요 시 수동으로 조절하여 상황에 맞게 사용하자 " />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginHorizontal="70dp"
                        android:layout_marginVertical="10dp"
                        android:background="#000000" />
                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="50dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tg5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="5. 자연스러움"
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textAlignment="center"/>

                    <TextView
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="30dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="경직된 자세로 사진을 찍으면 어색한 결과물이 나오기 때문에
                                \n다리를 꼬는 등의 자세를 취해 자연스러운 사진이 나오도록 하자" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginVertical="10dp"
                        android:layout_marginHorizontal="70dp"
                        android:background="#000000" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tg6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="6. 조명 및 각도"
                        android:textAlignment="center"
                        android:textSize="16dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="30dp"
                        android:text="사진은 빛으로 시작해서 빛으로 끝난다는 말이 있을 정도로
                                \n빛의 중요도가 높다. 여러가지 각도와 조명을 잘 조절한다면
                                \n멋진 사진을 만들어낼 수 있지만 어렵게 느껴진다면
                                \n가장 자연스러운 방식인 45도에 들어오는 빛인 사광을 사용하자" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginHorizontal="70dp"
                        android:layout_marginVertical="10dp"
                        android:background="#000000" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>